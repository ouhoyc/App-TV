# Server-only Vercel functions. Never add a service_role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# One persistent VAPID pair for native Web Push. Server-only; never prefix VITE_.
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
